{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && prisma generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "nuxi typecheck",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "tsx scripts/migrate-prod.ts",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/seo": "^5.3.14",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@takumi-rs/core": "^2.13.3",
    "@vueuse/nuxt": "^14.4.0",
    "chart.js": "^4.5.1",
    "daisyui": "^4.12.24",
    "eslint": "^10.9.1",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^3.21.11",
    "nuxt-auth-utils": "^0.5.30",
    "prisma": "^7.10.0",
    "vue": "^3.5.40",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.2.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nuxt/schema": "^3.21.11",
    "dotenv": "^17.4.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "@nuxt/cli": {
      "@nuxt/schema": "$@nuxt/schema"
    },
    "nuxtseo-shared": {
      "@nuxt/schema": "$@nuxt/schema"
    }
  }
