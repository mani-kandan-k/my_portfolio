# --- Database ---
# Dev: local SQLite file. Prod: Turso (libSQL) connection string.
DATABASE_URL="file:./dev.db"
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# --- GitHub OAuth (M3) ---
# Create an OAuth app under GitHub Settings → Developer settings.
# Callback URL: http://localhost:3000/api/auth/github (dev)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# GitHub username of the single allowlisted admin
ADMIN_GITHUB_USERNAME=""

# --- Session ---
# ≥ 32-char random secret for nuxt-auth-utils sealed cookies
NUXT_SESSION_PASSWORD=""

# --- Contact form / Resend (M7) ---
RESEND_API_KEY=""
CONTACT_TO_EMAIL=""

# --- Analytics (M7) ---
# Optional HMAC salt seed for visitor hashes (rotates daily by default)
ANALYTICS_SALT=""
ANALYTICS_RETENTION_MONTHS="12"

# --- SEO (M2) ---
# Canonical site URL used by @nuxtjs/seo (sitemap, canonical, og:url)
NUXT_PUBLIC_SITE_URL="http://localhost:3000"
